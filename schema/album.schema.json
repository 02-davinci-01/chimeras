{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "album.schema.json",
  "title": "Album entry (albums/<id>.json)",
  "type": "object",
  "required": [
    "id",
    "title",
    "artist",
    "year",
    "kingdom",
    "logseq",
    "added"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug, stable forever; also the file name."
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "spotify": {
      "type": [
        "string",
        "null"
      ],
      "description": "Spotify album id."
    },
    "cover": {
      "type": [
        "string",
        "null"
      ],
      "description": "640 px cover URL from Spotify; downloaded once by the build."
    },
    "runtime": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Minutes, optional."
    },
    "kingdom": {
      "enum": [
        "rock",
        "electronic",
        "hiphop",
        "indie"
      ]
    },
    "also": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": [
          "rock",
          "electronic",
          "hiphop",
          "indie"
        ]
      },
      "description": "Other kingdoms the album also belongs to. Each one draws a thread from the card into that kingdom in the world. Never includes its own kingdom."
    },
    "track": {
      "type": [
        "string",
        "null"
      ],
      "description": "Track the world plays when you meet the card, by name as it appears on the album. The build fetches a 30-second preview of it."
    },
    "logseq": {
      "type": "object",
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "string",
          "description": "Exact Logseq page name."
        }
      },
      "additionalProperties": false
    },
    "added": {
      "type": "string",
      "format": "date",
      "description": "Day the entry was created. Sets the card number order."
    },
    "first": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Day Vedant first listened. Hand-written on the obi strip. Null while sealed."
    },
    "pack": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-W\\d{2}$",
      "description": "ISO week of the pack it came in, if any."
    }
  }
}
